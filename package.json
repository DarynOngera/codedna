{
  "name": "codedna-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:all": "bash scripts/dev.sh",
    "dev:api": "npm --prefix server run dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro check && npm --prefix server run typecheck",
    "test": "npm --prefix server test",
    "audit:prod": "npm audit --omit=dev && npm --prefix server audit --omit=dev",
    "brand": "bash scripts/brand-assets.sh",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.13.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
