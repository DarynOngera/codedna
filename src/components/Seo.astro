---
import { SITE_NAME, SITE_URL } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Path relative to the site origin, e.g. "/about". Used for canonical + og:url. */
  path?: string;
  ogType?: string;
  jsonLd?: Record<string, unknown>;
}

const { title, description, path = '/', ogType = 'website', jsonLd } = Astro.props;

const canonical = new URL(path, SITE_URL).href;
const ogImage = new URL('/og-cover.png', SITE_URL).href;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content="index, follow" />
<meta name="color-scheme" content="light" />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${SITE_NAME} — Where Code Meets Biology`} />
<meta property="og:locale" content="en_US" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={`${SITE_NAME} — Where Code Meets Biology`} />

{
  jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )
}
