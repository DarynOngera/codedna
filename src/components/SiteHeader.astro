---
import { NAV_ITEMS, SITE_NAME } from '../data/site';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

const isCurrent = (href: string) => (href.replace(/\/+$/, '') || '/') === path;
---

<header class="site-header">
  <div class="container-page site-header__inner">
    <a href="/" class="brand" aria-label={`${SITE_NAME} — home`}>
      <img
        class="brand__logo"
        src="/logo-mark.png"
        width="152"
        height="39"
        alt={SITE_NAME}
      />
    </a>

    <nav aria-label="Primary">
      <ul class="nav">
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav__link"
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-block-end: 1px solid var(--color-rule);
    background-color: var(--color-paper);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.25rem;
    padding-block: 0.875rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: 0;
  }

  .brand__logo {
    display: block;
    width: auto;
    height: 1.625rem;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 4vw, 2.25rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-ink-muted);
    text-decoration: none;
    padding-block: 0.35rem;
    transition: color 150ms ease-out;
  }

  .nav__link:hover {
    color: var(--color-ink);
  }

  .nav__link[aria-current='page'] {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.45em;
  }
</style>
