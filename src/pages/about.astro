---
import CallToAction from '../components/CallToAction.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { SERVICES } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'About · CODEDNA';
const description =
  'CODEDNA is a corporate technology company. We build our own apps and provide artificial intelligence, cloud computing and IT consulting for businesses.';
---

<BaseLayout title={title} description={description} path="/about">
  <!-- Hero -->
  <section class="hero">
    <div class="container-page">
      <h1 class="text-h1 hero__title">About</h1>
      <p class="lede">
        The short version: CODEDNA is a corporate technology company. The slightly longer
        version is below.
      </p>
    </div>
  </section>

  <!-- 01 · The company -->
  <Section id="company" index="01" rule>
    <SectionHeading
      label="The company"
      title="A technology company, end to end"
    />
    <div class="prose">
      <p>
        CODEDNA builds software and puts it to work. We design and operate our own apps, and we
        take on artificial intelligence, cloud computing and IT consulting work for businesses
        that need them.
      </p>
      <p>
        We are deliberately small. That means the people who plan the work are the people who do
        it, and the person you talk to is the person who can change the code.
      </p>
    </div>
  </Section>

  <!-- 02 · What we do -->
  <Section id="work" index="02" rule tone="surface">
    <SectionHeading
      label="What we do"
      title="Four disciplines, one standard"
    />
    <ul class="work">
      {
        SERVICES.map((service, i) => (
          <li class="work__item">
            <span class="work__index" aria-hidden="true">
              {(i + 1).toString().padStart(2, '0')}
            </span>
            <div>
              <h3>{service.title}</h3>
              <p>{service.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- 03 · The name -->
  <Section id="name" index="03" rule>
    <SectionHeading
      label="The name"
      title="CODE plus DNA"
    />
    <p class="name-lockup" aria-hidden="true">
      CODE&thinsp;+&thinsp;DNA
    </p>
    <div class="prose">
      <p>
        Code is our home discipline — software understood as precision, structure and method.
        DNA is what every product shares: the reusable pattern underneath, the part that makes
        one build inherit the strengths of the last. The name binds the two.
      </p>
    </div>
  </Section>

  <!-- 04 · How we work -->
  <Section id="how" index="04" rule>
    <SectionHeading
      label="How we work"
      title="Measured before announced"
    />
    <div class="prose">
      <p>
        We ship working software over promises. Architecture comes before frameworks, and an
        honest timeline beats an ambitious one that slips.
      </p>
      <p>
        Our products are the proof of the method: we run what we build, so we feel the
        consequences of every shortcut.
      </p>
    </div>
  </Section>

  <!-- 05 · Contact -->
  <CallToAction
    index="05"
    title="Talk to us"
    body="If you have a problem worth solving with software, cloud or AI, we would like to hear about it."
  />
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(4.5rem, 12vw, 7.5rem) clamp(3.5rem, 9vw, 6rem);
    border-block-end: 1px solid var(--color-rule);
  }

  .hero__title {
    margin: 0;
  }

  .hero .lede {
    margin-block-start: 1.5rem;
    max-width: 46ch;
  }

  .prose p {
    margin: 0;
  }

  .name-lockup {
    font-size: clamp(1.75rem, 2.5vw + 1rem, 3rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    margin: 2.5rem 0;
  }

  .work {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    max-width: 52rem;
  }

  .work__item {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    border-block-start: 1px solid var(--color-rule);
    padding-block: 1.5rem;
  }

  @media (min-width: 48rem) {
    .work__item {
      grid-template-columns: 5rem minmax(0, 1fr);
    }
  }

  .work__index {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--text-micro--letter-spacing);
    color: var(--color-ink-faint);
  }

  .work__item h3 {
    font-size: 1.125rem;
    font-weight: 500;
    margin: 0;
  }

  .work__item p {
    margin: 0.5rem 0 0;
    color: var(--color-ink-muted);
    max-width: 52ch;
  }
</style>
