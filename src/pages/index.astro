---
import ActionLink from '../components/ActionLink.astro';
import CallToAction from '../components/CallToAction.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { APPS } from '../data/apps';
import {
  CONTACT_EMAIL,
  SERVICES,
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_TITLE,
  SITE_URL,
} from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  url: SITE_URL,
  logo: new URL('/logo.png', SITE_URL).href,
  description: SITE_DESCRIPTION,
  email: CONTACT_EMAIL,
  knowsAbout: SERVICES.map((service) => service.title),
};
---

<BaseLayout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  path="/"
  jsonLd={organization}
>
  <!-- 00 · Hero -->
  <section class="hero section--inverse">
    <div class="container-page hero__inner">
      <h1 class="display hero__title">
        Software, Cloud<br />&amp; AI for businesses.
      </h1>
      <div class="hero__body">
        <p class="lede hero__lede">
          CODEDNA, your all-in-one technology partner for custom software, IT consulting,
          AI acceleration, and cloud solutions.

          Helping businesses innovate, operate smarter,
          and scale with confidence.
        </p>

        <p class="hero__actions">
          <ActionLink href="/contact" variant="light">Contact</ActionLink>
          <ActionLink href="/apps" variant="text">See our apps</ActionLink>
        </p>
        <hr class="hairline hero__rule" />
        <p class="micro">CODE / DNA</p>
      </div>
      <img
        class="hero__logo"
        src="/logo-inverse.png"
        width="1200"
        height="468"
        alt={SITE_NAME}
      />
    </div>
  </section>

  <!-- 01 · Introduction -->
  <Section id="introduction" index="01" rule>
    <SectionHeading
      label="Introduction"
      title="One company, four disciplines"
      lede="CODEDNA builds products and solves problems with technology. Apps, artificial intelligence, cloud computing and IT consulting sit under one roof."
    />
    <p class="prose prose--indent">
      We build software we run ourselves, and we bring the same engineering discipline to work we
      do for other businesses. The two reinforce each other: products keep us sharp, and client
      work keeps us close to real constraints.
    </p>
  </Section>

  <!-- 02 · Services -->
  <Section id="services" index="02" rule tone="surface">
    <SectionHeading
      label="Services"
      title="What we do"
      lede="Four areas, delivered by the same small team."
    />
    <ul class="services">
      {
        SERVICES.map((service, i) => (
          <li class="service">
            <span class="service__index" aria-hidden="true">
              {(i + 1).toString().padStart(2, '0')}
            </span>
            <div class="service__body">
              <h3>{service.title}</h3>
              <p>{service.body}</p>
              {'href' in service && service.href && (
                <p class="service__link">
                  <a href={service.href}>Explore apps →</a>
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- 03 · Apps -->
  <Section id="apps" index="03" rule>
    <SectionHeading
      label="Apps"
      title="Products we build"
      lede="Software we own and operate. More are on the way."
    />
    <ul class="apps">
      {
        APPS.map((app) => (
          <li class="app">
            <div class="app__head">
              <h3>{app.name}</h3>
              <span class="micro">{app.status}</span>
            </div>
            <p class="app__tagline">{app.tagline}</p>
            <p class="app__summary">{app.summary}</p>
            <p class="app__link">
              <a href={app.href}>About {app.name} →</a>
            </p>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- 04 · Approach -->
  <Section id="approach" index="04" rule>
    <SectionHeading
      label="Approach"
      title="Engineering, not theatre"
      lede="Straightforward software, delivered by people who will still be there after launch."
    />
    <p class="prose">
      We prefer clear architecture, honest timelines and systems that are easy to operate.
      Whether we are shipping one of our own apps or a client platform, the goal is the same:
      software that does its job and can be maintained by the next person who touches it.
    </p>
  </Section>

  <!-- 05 · Contact -->
  <CallToAction
    index="05"
    title="Let's build something"
    body="Tell us what you are working on, or ask about one of our apps. We read everything and reply."
  />
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(5rem, 14vw, 9rem) clamp(3.5rem, 9vw, 6.5rem);
    border-block-end: 1px solid rgba(255, 255, 255, 0.25);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'title'
      'body'
      'logo';
    gap: clamp(2.5rem, 6vw, 4rem);
  }

  .hero__body {
    grid-area: body;
    max-width: 48rem;
  }

  .hero__title {
    grid-area: title;
    max-width: 14ch;
    margin: 0;
    color: var(--color-paper);
  }

  .hero__lede {
    max-width: 46ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    margin-block-start: clamp(2rem, 5vw, 3rem);
  }

  .hero__rule {
    margin-block-start: clamp(3rem, 7vw, 5rem);
    margin-block-end: 1rem;
    border-block-start-color: rgba(255, 255, 255, 0.25);
  }

  .hero__logo {
    grid-area: logo;
    width: 100%;
    height: auto;
    max-width: 32rem;
  }

  @media (min-width: 64rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'title logo'
        'body  body';
      align-items: center;
      column-gap: clamp(2.5rem, 6vw, 5rem);
    }

    .hero__logo {
      width: auto;
      max-width: 26rem;
      justify-self: end;
    }
  }

  .prose--indent {
    margin-block-start: 2rem;
  }

  /* Services — equal four-card grid */
  .services {
    display: grid;
    gap: 0;
    list-style: none;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    border-block-start: 1px solid var(--color-rule);
  }

  @media (min-width: 40rem) {
    .services {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .services {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .service {
    display: grid;
    gap: 1rem;
    align-content: start;
    padding: 1.75rem 1.5rem 2rem 0;
    border-block-end: 1px solid var(--color-rule);
  }

  @media (min-width: 40rem) {
    .service {
      padding-inline-end: 2rem;
      border-inline-start: 1px solid var(--color-rule);
      padding-inline-start: 1.5rem;
    }

    .service:nth-child(odd) {
      border-inline-start: 0;
      padding-inline-start: 0;
    }
  }

  @media (min-width: 64rem) {
    .service {
      border-inline-start: 1px solid var(--color-rule);
      border-block-end: 0;
      padding-inline-start: 1.5rem;
    }

    .service:first-child {
      border-inline-start: 0;
      padding-inline-start: 0;
    }
  }

  .service__index {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--text-micro--letter-spacing);
    color: var(--color-ink-faint);
  }

  .service h3 {
    font-size: 1.125rem;
    font-weight: 500;
    margin: 0;
  }

  .service p {
    margin: 0.5rem 0 0;
    color: var(--color-ink-muted);
  }

  .service__link {
    font-weight: 500;
  }

  .service__link a {
    color: var(--color-ink);
  }

  /* Apps */
  .apps {
    display: grid;
    gap: 1px;
    list-style: none;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    border: 1px solid var(--color-rule);
    background-color: var(--color-rule);
  }

  @media (min-width: 48rem) {
    .apps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .app {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    background-color: var(--color-paper);
    padding: 1.75rem 1.75rem 2rem;
  }

  .app__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .app__head h3 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 500;
  }

  .app__tagline {
    margin: 0;
    font-size: var(--text-h3);
    line-height: var(--text-h3--line-height);
    letter-spacing: var(--text-h3--letter-spacing);
  }

  .app__summary {
    margin: 0;
    color: var(--color-ink-muted);
    max-width: 52ch;
  }

  .app__link {
    margin: 0.25rem 0 0;
    font-weight: 500;
  }
</style>
