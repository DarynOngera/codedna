# Copy to .env for local development (never commit .env).
# On the server these live in /etc/codedna/api.env (root:api-user, mode 0600).

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where contact submissions are delivered
CONTACT_TO_EMAIL=hello@c0dedna.com

# Must be a domain verified in your Resend account
CONTACT_FROM_EMAIL=website@c0dedna.com

# Comma-separated allowlist of browser origins permitted to call the API
ALLOWED_ORIGINS=https://c0dedna.com,https://www.c0dedna.com,http://localhost:4321

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5

# 1 = behind Nginx/Cloudflare (trust X-Forwarded-For from our proxy only)
TRUST_PROXY=1

NODE_ENV=development
PORT=3000
